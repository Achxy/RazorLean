  "chains": [
    {
      "id": "CHAIN-REFUND-MUTATION-RETRY-OBSERVABILITY",
      "title": "A malformed refund is silently changed, then lacks a stable retry identity",
      "component_findings": [
        "RP-MCP-REFUND-TRUNCATION",
        "RP-MCP-REFUND-IDEMPOTENCY"
      ],
      "consequence": "A network interruption after acceptance can leave both the sent amount and effect identity uncertain.",
      "demonstration": "Intercept the provider request, submit 100.75 twice around a forced disconnect, and compare request bodies and refund IDs."
    },
    {
      "id": "CHAIN-CHECKOUT-ECONOMIC-DECOUPLING",
      "title": "Browser authority, binary floats, and a fixed exponent decouple charge from catalog price",
      "component_findings": [
        "RP-MCP-GENERATOR-UNTRUSTED-ECONOMICS",
        "RP-MCP-GENERATOR-MONEY-UNDERCHARGE",
        "RP-MCP-GENERATOR-CURRENCY-EXPONENT"
      ],
      "consequence": "A fresh generated checkout can accept a tampered or mis-scaled amount and still produce a validly signed provider payment.",
      "demonstration": "Generate the integration, change the browser amount, and run INR 2.01, JPY 295, and KWD 295.990 controls against captured outbound orders."
    },
    {
      "id": "CHAIN-MOBILE-PAID-BUT-FAILED",
      "title": "Mobile success loses the signature required by the generated server verifier",
      "component_findings": [
        "RP-MCP-MOBILE-MISSING-SIGNATURE"
      ],
      "consequence": "The provider can report success while the merchant cannot complete its generated verification path.",
      "demonstration": "Run each generated success callback and assert that the signed payment tuple reaches the server intact."
    },
    {
      "id": "CHAIN-CROSS-TENANT-ROUTING",
      "title": "Process-wide SDK state can redirect concurrent tenant traffic",
      "component_findings": [
        "RP-DOTNET-GLOBAL-AUTH-STATE",
        "RP-PHP-GLOBAL-AUTH-STATE",
        "RP-JAVA-GLOBAL-PARTNER-HEADERS"
      ],
      "consequence": "Creating or mutating one client can change credentials or partner routing used by another client in the same process.",
      "demonstration": "Instantiate tenants A and B, interleave requests through a capture server, and assert every Authorization and X-Razorpay-Account pair."
    },
    {
      "id": "CHAIN-JAVA-DOCUMENT-WIRE-CORRUPTION",
      "title": "Java document serialization combines a wrong MIME with duplicate file parts",
      "component_findings": [
        "RP-JAVA-UPLOAD-MIME",
        "RP-JAVA-UPLOAD-DUPLICATE-FILE-PART"
      ],
      "consequence": "An otherwise valid JPG or PNG can reach the document endpoint as an ambiguous multipart body.",
      "demonstration": "Capture the multipart request and assert one binary file part whose Content-Type matches its magic bytes."
    },
    {
      "id": "CHAIN-MOBILE-PACKAGE-IDENTITY",
      "title": "Generated payment code crosses into an unrelated package namespace",
      "component_findings": [
        "RP-MCP-MOBILE-DEPENDENCY-CONFUSION"
      ],
      "consequence": "A copy-pasted integration depends on an identity outside Razorpay's documented package boundary.",
