# Test Mode only. Prefer a local secret manager in real deployments.
RAZORPROOF_HOST_KEY_CSV=/absolute/path/to/rzp-key.csv
RAZORPROOF_KEY_CSV=/run/secrets/rzp-key.csv
RAZORPROOF_TENANT=hackathon_demo
RAZORPROOF_GATEWAY_TOKEN=replace-with-at-least-24-random-characters
RAZORPROOF_WEBHOOK_SECRET=replace-with-dashboard-test-webhook-secret
RAZORPROOF_DATABASE_URL=sqlite:///data/razorproof.db
RAZORPROOF_BIND=0.0.0.0:8787
RUST_LOG=razorproof=info,tower_http=info
