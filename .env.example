# Copy to .env.local. Use Razorpay Test Mode credentials only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_locally

# Optional: use a different RazorpayX Test Mode key pair if the account exposes it.
RAZORPAYX_KEY_ID=rzp_test_replace_me
RAZORPAYX_KEY_SECRET=replace_me_locally
